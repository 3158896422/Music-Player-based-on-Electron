{
  "name": "music-player",
  "version": "1.0.0",
  "description": "Apple Music风格的本地音乐播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "music",
    "player",
    "electron"
  ],
  "author": "Music Player",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "@lrc-player/core": "^1.1.5",
    "@lrc-player/parse": "^1.0.0",
    "axios": "^1.13.6",
    "crypto-js": "^4.2.0",
    "iconv-lite": "^0.7.2",
    "image-size": "^2.0.2",
    "music-metadata": "^7.14.0",
    "needle": "^3.5.0",
    "NeteaseCloudMusicApi": "^4.30.0",
    "node-id3": "^0.2.9",
    "node-taglib-sharp": "^6.0.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.30",
    "vue-audio-visual": "^3.1.0"
  },
  "build": {
    "appId": "com.musicplayer.app",
    "productName": "Music Player",
    "directories": {
      "output": "build-output-20240325"
    },
    "files": [
      "**/*",
      "!build-output-20240325/**",
      "!release/**",
      "!dist/**",
      "!log/**",
      "!sources/**",
      "!**/*.md",
      "!**/*.class",
      "!**/*.java"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "fengmian.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music Player"
    }
  }
}
